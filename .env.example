# =============================================================================
# MindMentor — Flutter Environment Variables
# =============================================================================
# Copy this file to .env and fill in your Supabase project credentials.
#
# These values are passed to Flutter at build time using --dart-define:
#   flutter run \
#     --dart-define=SUPABASE_URL=$SUPABASE_URL \
#     --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
#
# Find these in your Supabase Dashboard:
#   → Project Settings → API → Project URL & anon/public key
# =============================================================================

# Your Supabase project URL (e.g., https://abcdefghij.supabase.co)
SUPABASE_URL=

# Your Supabase anonymous (public) key — safe to embed in client
SUPABASE_ANON_KEY=
